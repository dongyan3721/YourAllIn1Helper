{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "All-in-One Toolbox",
  "version": "0.1.0",
  "identifier": "com.allinone.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --dir src-ui run build:fast",
    "beforeDevCommand": "pnpm --dir src-ui run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
