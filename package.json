{
  "name": "your_all_in_one",
  "version": "0.1.4-beta",
  "private": true,
  "scripts": {
    "setup": "pnpm --dir src-ui install --frozen-lockfile",
    "tauri": "node src-ui/node_modules/@tauri-apps/cli/tauri.js",
    "dev": "pnpm tauri dev",
    "build:ui": "pnpm --dir src-ui run build:fast",
    "build:app": "pnpm tauri build",
    "build:desktop": "pnpm tauri build --debug --no-bundle"
  }
}
